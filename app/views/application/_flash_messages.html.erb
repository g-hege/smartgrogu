<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <div 
    class="fixed top-5 left-1/2 transform -translate-x-1/2 z-50 max-w-md w-full px-4"
    data-controller="flash"
  >
    <div class="
      px-4 py-3 rounded-md shadow-lg text-white text-center animate-fade-in-down
      <%= type == 'alert' ? 'bg-red-600' : 'bg-green-600' %>
    ">
      <%= message %>
    </div>
  </div>
<% end %>
