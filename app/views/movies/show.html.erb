<div class="card my-4">

  <h1 class="card-title"><%= @movie["title"] %></h1>

  <p class="card-subtitle">
   <%= @movie["tagline"] %>
  </p>

  <% if @movie["original_title"].present? && @movie["original_title"] != @movie["title"] %>
    <p class="text-muted italic">
      Original: <%= @movie["original_title"] %>
    </p>
  <% end %>


  <div class="card-body">
    <%= @movie["overview"]%>
  </div>

  <div class="card my-4 bg-white shadow-md rounded-lg p-6">
    <div class="mt-8">
      <h3 class="text-xl font-bold mb-4">Besetzung</h3>
      
      <div class="flex overflow-x-auto pb-4 gap-4 snap-x snap-mandatory scrollbar-hide">
        <% @movie["cast"].each do |member| %>
        <div class="flex-none w-32 md:w-40 snap-start">
  
        <div class="w-full aspect-[2/3] overflow-hidden rounded-xl shadow-sm bg-gray-200">
          <% if member["profile_path"].present? %>
            <img src="https://image.tmdb.org/t/p/w185<%= member["profile_path"] %>" 
                 class="w-full h-full object-cover" 
                 alt="<%= member["name"] %>">
          <% else %>
            <div class="w-full h-full flex items-center justify-center">
              <span class="text-gray-400 text-[10px] uppercase">no pic</span>
            </div>
          <% end %>
        </div>
        
        <div class="mt-2 w-full px-1">
          <p class="text-sm font-bold text-gray-900 truncate block" title="<%= member["name"] %>">
            <%= member["name"] %>
          </p>
          <p class="text-xs text-gray-500 truncate block" title="<%= member["character"] %>">
            <%= member["character"] %>
          </p>
        </div>

      </div>
        <% end %>
      </div>
    </div>
  </div>



  <div class="card-actions">

  </div>
</div>



