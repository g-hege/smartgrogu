<div class="flex flex-col space-y-8">

  <%= render Avo::PanelComponent.new(name: 'Energy Dashboard', display_breadcrumbs: true) do |c| %>

    <% c.with_tools do %>
      <div class="text-sm italic">Work in progress.</div>
    <% end %>

    <% c.with_body do %>





      <!-- Jahresauswahl -->
      <div class="mb-8 ">
        <%= form_with url: "/avo/dashboard", method: :get, local: true do %>
          <label for="year" class="mr-2 font-medium mt-4 ml-4">Jahr auswählen:</label>
          <%= select_tag :year,
            options_for_select(
              Energy.group(Arel.sql("EXTRACT(YEAR FROM day)"))
                    .pluck(Arel.sql("EXTRACT(YEAR FROM day)::int"))
                    .uniq
                    .sort,
              params[:year].presence || Date.today.year
            ),
            onchange: "this.form.submit();",
            class: "border rounded p-1" %>
        <% end %>
      </div>

      <!-- Monats-Chart für ausgewähltes Jahr -->
      <% selected_year = (request.query_parameters[:year] || Date.today.year).to_i %>
      <% @invoicedata = EnergyStatistics.invoice_data %>
      <% @totaldata   = EnergyStatistics.total_data(@invoicedata) %>
      <% @totalmonth  = EnergyStatistics.total_data_by_year(@invoicedata,selected_year) %>


      <div class="p-4 rounded-xl shadow bg-white mt-8 mb-4">
        <h2 class="text-lg font-semibold mb-2">Monatlicher Verbrauch <%= selected_year %></h2>
        <%= column_chart EnergyStatistics.by_month(selected_year).map { |name, data| { name: name, data: data } },
          xtitle: selected_year.to_s,
          ytitle: "kWh",
          library: {
            height: 350,
            plotOptions: {
              column: {
                dataLabels: { enabled: true, formatter: "function() { return this.y; }" }
              }
            }
          } %>
      </div>


      <!-- KPI-Cards by year-->


      <div class="p-4  shadow bg-white mt-2 mb-2">
        <h2 class="text-lg font-semibold mb-2">Jahr <%= selected_year %></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">

        <div class="p-4 rounded-xl shadow bg-white">
          <p class="text-sm text-gray-500">Verbrauch Grid (Wien Energie)</p>
          <p class="text-lg font-semibold">
            <%= number_with_precision(Energy.where(Arel.sql("EXTRACT(YEAR FROM day) = #{selected_year}")).sum(:real_wiener_netze), precision: 2, delimiter: ".", separator: ",") %> kWh
          </p>
        </div>

        <div class="p-4 rounded-xl shadow bg-white">
          <p class="text-sm text-gray-500">Solar Eigenverbrauch</p>
          <p class="text-lg font-semibold">
            <%= number_with_precision(Energy.where(Arel.sql("EXTRACT(YEAR FROM day) = #{selected_year}")).sum(:solar_self_consumed), precision: 2, delimiter: ".", separator: ",") %> kWh
          </p>
        </div>

        <div class="p-4 rounded-xl shadow bg-white">
          <p class="text-sm text-gray-500">Solar ins Netz</p>
          <p class="text-lg font-semibold">
            <%= number_with_precision(Energy.where(Arel.sql("EXTRACT(YEAR FROM day) = #{selected_year}")).sum(:solar_to_grid), precision: 2, delimiter: ".", separator: ",") %> kWh
          </p>
        </div>

        <div class="p-4 rounded-xl shadow bg-white">
          <p class="text-sm text-gray-500">Grid Price Netto</p>
          <p class="text-lg font-semibold">
            <%= number_with_precision(Energy.where(Arel.sql("EXTRACT(YEAR FROM day) = #{selected_year}")).sum(:grid_price_netto), precision: 2, delimiter: ".", separator: ",") %> €
          </p>
        </div>

        <div class="p-4 rounded-xl shadow bg-white">
          <p class="text-sm text-gray-500">Ø Autarkie-Rate</p>
          <p class="text-lg font-semibold"><%= EnergyStatistics.autarkie_rate_by_year(selected_year) %> %</p>
        </div>

        <div class="p-4 rounded-xl shadow bg-white">
          <p class="text-sm text-gray-500">Ø Eigenverbrauchs-Rate</p>
          <p class="text-lg font-semibold"><%= EnergyStatistics.own_consumption_rate(selected_year) %> %</p>
        </div>


        <div class="p-4 rounded-xl shadow bg-white">
          <p class="text-sm text-gray-500">Kosten Brutto im Jahr <%= selected_year %></p>
          <p class="text-lg font-semibold text-red-500">
            <%= number_with_precision( @totalmonth[:brutto], precision: 2, delimiter: ".", separator: ",") %> €
          </p>
        </div>


        <div class="p-4 rounded-xl shadow bg-white">
          <p class="text-sm text-gray-500">Solar Ersparnis im Jahr <%= selected_year %></p>
          <p class="text-lg font-semibold text-green-500">
            <%= number_with_precision( @totalmonth[:solar_self_price], precision: 2, delimiter: ".", separator: ",") %> €
          </p>
        </div>

      </div>

      <div class="p-4  shadow bg-white mt-2 mb-2">
        <h2 class="text-lg font-semibold mb-2">Total seit 2015</h2>
      </div>

      <!-- KPI-Cards all Year -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
        <div class="p-4 rounded-xl shadow bg-white">
          <p class="text-sm text-gray-500">Gesamtverbrauch (Wien Energie)</p>
          <p class="text-lg font-semibold">
            <%= number_with_precision(62258 + Energy.sum(:real_wiener_netze), precision: 2, delimiter: ".", separator: ",") %> kWh
          </p>
        </div>

        <div class="p-4 rounded-xl shadow bg-white">
          <p class="text-sm text-gray-500">Solar Eigenverbrauch</p>
          <p class="text-lg font-semibold">
            <%= number_with_precision(Energy.sum(:solar_self_consumed), precision: 2, delimiter: ".", separator: ",") %> kWh
          </p>
        </div>

        <div class="p-4 rounded-xl shadow bg-white">
          <p class="text-sm text-gray-500">Solar ins Netz</p>
          <p class="text-lg font-semibold">
            <%= number_with_precision(Energy.sum(:solar_to_grid), precision: 2, delimiter: ".", separator: ",") %> kWh
          </p>
        </div>

        <div class="p-4 rounded-xl shadow bg-white">
          <p class="text-sm text-gray-500">Solar Ersparnis total</p>
          <p class="text-lg font-semibold text-green-500">
            <%= number_with_precision( @totaldata[:solar_self_price], precision: 2, delimiter: ".", separator: ",") %> €
          </p>
        </div>

      </div>

      <!-- Jahres-Chart -->
      <div class="p-4 rounded-xl shadow bg-white mt-8">
        <h2 class="text-lg font-semibold mb-2">Energieverbrauch nach Jahr</h2>
        <%= column_chart EnergyStatistics.by_year.map { |name, data| { name: name, data: data } },
          xtitle: "Jahr",
          ytitle: "kWh",
          stacked: false,
          library: { height: "350px" } %>
      </div>

      <!-- Energy Timeline Fullwidth -->
      <div class="w-screen -mx-4 p-4 rounded-xl shadow bg-white mt-8">
        <h2 class="text-lg font-semibold mb-2">Energy Timeline</h2>
        <%= line_chart(EnergyStatistics.energy_timeline, width: "100%") %>
      </div>


      <div class="grid grid-cols-2 md:grid-cols-2 gap-6 mt-8">
        <div class="p-4 rounded-xl shadow bg-white">
          <h2 class="text-lg font-semibold mb-2">Solar-Anteil seit 1-Aug 2023</h2>
          <%= pie_chart({
              "Grid - Wien Energie" => Energy.where("day > ?", "2023-08-01").sum(:real_wiener_netze),
              "Eigenverbrauch" => Energy.where("day > ?", "2023-08-01").sum(:solar_self_consumed),
              "Einspeisung" => Energy.where("day > ?", "2023-08-01").sum(:solar_to_grid)
            },
            donut: true,
            legend: "bottom",
            library: {
              plotOptions: {
                pie: {
                  dataLabels: {
                    enabled: true,
                    format: '<b>{point.name}</b>: {point.percentage:.1f} %'
                  }
                }
              }
            }) %>
        </div>

        <div class="p-4 rounded-xl shadow bg-white">
          <h2 class="text-lg font-semibold mb-2">Solar-Anteil <%= selected_year %></h2>
          <%= pie_chart(
            {
              "Grid - Wien Energie" => Energy.where("EXTRACT(YEAR FROM day) = ?", selected_year).sum(:real_wiener_netze),
              "Eigenverbrauch"      => Energy.where("EXTRACT(YEAR FROM day) = ?", selected_year).sum(:solar_self_consumed),
              "Einspeisung"         => Energy.where("EXTRACT(YEAR FROM day) = ?", selected_year).sum(:solar_to_grid)
            },
            donut: true,
            legend: "bottom",
            library: {
              plotOptions: {
                pie: {
                  showInLegend: true
                }
              },
              legend: {
                labelFormatter: "function() { return this.name + ' (' + Highcharts.numberFormat(this.percentage, 1) + '%)'; }"
              }
            }
          ) %>

        </div>
      </div>


<!----------------------------- Tabelle Totel Abbrechnung-->

      <div class="p-4  shadow bg-white mt-2 mb-2">
        <h2 class="text-lg font-semibold mb-2">Total invoice Summary</h2>
      </div>


<div class="overflow-x-auto relative shadow-md sm:rounded-lg">
  <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
    <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
      <tr>
        <th scope="col" class="py-3 px-6">Monat</th>
        <th scope="col" class="py-3 px-6">Grid kWh</th>
        <th scope="col" class="py-3 px-6">Stromkosten</th>
        <th scope="col" class="py-3 px-6">Netzentgelte</th>
        <th scope="col" class="py-3 px-6">Gebühren</th>
        <th scope="col" class="py-3 px-6">Brutto</th>
        <th scope="col" class="py-3 px-6">Brutto-Preis/kWh</th>
        <th scope="col" class="py-3 px-6">Solar Self</th>
        <th scope="col" class="py-3 px-6">Solar Self Price</th>
      </tr>
    </thead>
    <tbody>
      <% @invoicedata.each do |item| %>
        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
          <td class="py-4 px-6 font-medium text-gray-900 whitespace-nowrap dark:text-white">
            <%= item[:month] %>
          </td>
          <td class="py-4 px-6">
            <%= '%.2f' % item[:grid_kwh] %> kWh
          </td>
          <td class="py-4 px-6">
            <%= '%.2f' % item[:stromkosten] %> €
          </td>
          <td class="py-4 px-6">
            <%= '%.2f' % item[:netzentgelte] %> €
          </td>
          <td class="py-4 px-6">
            <%= '%.2f' % item[:gebuehren] %> €
          </td>
          <td class="py-4 px-6 font-bold">
            <%= '%.2f' % item[:brutto] %> €
          </td>
          <td class="py-4 px-6">
            <%= '%.2f' % item[:brutto_price_kwh] %> €
          </td>
          <td class="py-4 px-6">
            <%= '%.2f' % item[:solar_self] %> kWh
          </td>
          <td class="py-4 px-6 font-bold">
            <%= '%.2f' % item[:solar_self_price] %> €
          </td>
        </tr>
      <% end %>
    </tbody>

    <tfoot class="text-sm text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400 font-bold">
      <tr>
        <td class="py-3 px-6">
          Gesamt
        </td>
        <td class="py-3 px-6">
          <%= '%.2f' % @totaldata[:grid_kwh] %> kWh
        </td>
        <td class="py-3 px-6">
          <%= '%.2f' % @totaldata[:stromkosten] %> €
        </td>
        <td class="py-3 px-6">
          <%= '%.2f' % @totaldata[:netzentgelte] %> €
        </td>
        <td class="py-3 px-6">
          <%= '%.2f' % @totaldata[:gebuehren] %> €
        </td>
        <td class="py-3 px-6 text-red-500">
          <%= '%.2f' % @totaldata[:brutto] %> €
        </td>
        <td class="py-3 px-6">
          </td>
        <td class="py-3 px-6">
          <%= '%.2f' % @totaldata[:solar_self] %> kWh
        </td>
        <td class="py-3 px-6 text-green-500">
          <%= '%.2f' % @totaldata[:solar_self_price] %> €
        </td>
      </tr>
    </tfoot>
  </table>
</div>



    <% end %>

  <% end %>
</div>
