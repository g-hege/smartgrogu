<div class="flex flex-col">
  <%= render Avo::PanelComponent.new(name: 'Temperature dashboard', display_breadcrumbs: true) do |c| %>
    <% c.with_tools do %>
      <div class="text-sm italic">note</div>
    <% end %>

    <% c.with_body do %>

     <% @data = EnergyStatistics.consumption_by_day('solar',50) %>
      <!-- Energy Timeline Fullwidth -->
      <div class="w-screen -mx-4 p-4 rounded-xl shadow bg-white mt-8">
        <h2 class="text-lg font-semibold mb-2">Solar by day kWh</h2>
        <%= column_chart(@data, width: "100%") %>
      </div>

     <% @data = EnergyStatistics.consumption_by_week('solar',33) %>
      <!-- Energy Timeline Fullwidth -->
      <div class="w-screen -mx-4 p-4 rounded-xl shadow bg-white mt-8">
        <h2 class="text-lg font-semibold mb-2">Solar by week kWh</h2>
        <%= column_chart(@data, width: "100%") %>
      </div>



      <% @data = EnergyStatistics.consumption_by_month('pool') %>
      <!-- Energy Timeline Fullwidth -->
      <div class="w-screen -mx-4 p-4 rounded-xl shadow bg-white mt-8">
        <h2 class="text-lg font-semibold mb-2">Pool Consumption</h2>
        <%= line_chart(@data, width: "100%") %>
      </div>
    
      <% @data = EnergyStatistics.consumption_by_month('boiler') %>
      <!-- Energy Timeline Fullwidth -->
      <div class="w-screen -mx-4 p-4 rounded-xl shadow bg-white mt-8">
        <h2 class="text-lg font-semibold mb-2">Boiler Consumption</h2>
        <%= line_chart(@data, width: "100%") %>
      </div>

      <% @data = EnergyStatistics.consumption_by_month('dryer') %>
      <!-- Energy Timeline Fullwidth -->
      <div class="w-screen -mx-4 p-4 rounded-xl shadow bg-white mt-8">
        <h2 class="text-lg font-semibold mb-2">Trockner Consumption</h2>
        <%= line_chart(@data, width: "100%") %>
      </div>

      <% @data = EnergyStatistics.consumption_by_month('waschmaschine') %>
      <!-- Energy Timeline Fullwidth -->
      <div class="w-screen -mx-4 p-4 rounded-xl shadow bg-white mt-8">
        <h2 class="text-lg font-semibold mb-2">Waschmaschine Consumption</h2>
        <%= line_chart(@data, width: "100%") %>
      </div>

      <% @data = EnergyStatistics.consumption_by_month('tv') %>
      <!-- Energy Timeline Fullwidth -->
      <div class="w-screen -mx-4 p-4 rounded-xl shadow bg-white mt-8">
        <h2 class="text-lg font-semibold mb-2">TV Consumption</h2>
        <%= line_chart(@data, width: "100%") %>
      </div>

      <% @data = EnergyStatistics.consumption_by_month('workplace') %>
      <!-- Energy Timeline Fullwidth -->
      <div class="w-screen -mx-4 p-4 rounded-xl shadow bg-white mt-8">
        <h2 class="text-lg font-semibold mb-2">Workplace Consumption</h2>
        <%= line_chart(@data, width: "100%") %>
      </div>

      <% @data = EnergyStatistics.consumption_by_month('fridge2') %>
      <!-- Energy Timeline Fullwidth -->
      <div class="w-screen -mx-4 p-4 rounded-xl shadow bg-white mt-8">
        <h2 class="text-lg font-semibold mb-2">Logia Kühlschrank Consumption</h2>
        <%= line_chart(@data, width: "100%") %>
      </div>

     <% @data = EnergyStatistics.recording_by_month('temp-garden') %>
      <!-- Energy Timeline Fullwidth -->
      <div class="w-screen -mx-4 p-4 rounded-xl shadow bg-white mt-8">
        <h2 class="text-lg font-semibold mb-2">Temp Garden</h2>
        <%= line_chart(@data, width: "100%") %>
      </div>





    <% end %>
  <% end %>
</div>
