<div class="flex flex-col">
  <%= render Avo::PanelComponent.new(name: 'Temperature dashboard', display_breadcrumbs: true) do |c| %>
    <% c.with_tools do %>
      <div class="text-sm italic">note</div>
    <% end %>

    <% c.with_body do %>

<div id="graph" data-chart-options="<%= @chart.options.to_json %>">
  </div>

<script>
  // Funktion, die das Highcharts-Diagramm rendert
  function renderChart() {
    // 1. Hole die Optionen aus dem data-Attribut des Divs
    const chartContainer = document.getElementById('graph');
    if (!chartContainer) return;

    // Verwende JSON.parse, um die Optionen aus dem Attribut zu bekommen
    const optionsJson = chartContainer.getAttribute('data-chart-options');
    if (!optionsJson) return;
    
    // Stelle sicher, dass Highcharts verfügbar ist
    if (typeof Highcharts === 'undefined') {
      console.error("Highcharts ist noch nicht definiert. Prüfen Sie das Laden in application.js.");
      return;
    }

    try {
      const options = JSON.parse(optionsJson);
      
      // 2. Erzeuge das Diagramm
      new Highcharts.Chart(options);
    } catch (e) {
      console.error("Fehler beim Parsen der Chart-Optionen:", e);
    }
  }

  // 3. Füge einen Event-Listener hinzu, der sowohl beim ersten Laden
  //    als auch nach Turbo-Navigationen das Diagramm rendert
  document.addEventListener('turbo:load', renderChart);
  
  // Optional: Wenn es eine Full-Page-Reload ist, führe es sofort aus
  if (document.readyState === 'complete') {
    renderChart();
  }
</script>

